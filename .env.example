# MongoDB (Local) — local-only dev, no auth (mongod runs as Windows service w/o auth)
MONGODB_URI=mongodb://localhost:27017/fsae_db

# App
PORT=3000
NODE_ENV=development

# Google Drive Service Account (paste the minified JSON)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Parent folder ID from Drive (e.g. FSAE_2026)
GOOGLE_DRIVE_PARENT_FOLDER_ID=1ABCxyz...
